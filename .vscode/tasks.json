{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DB: start MariaDB",
      "type": "shell",
      "command": "docker compose up -d db",
      "problemMatcher": []
    },
    {
      "label": "Backend: run FastAPI",
      "type": "shell",
      "command": "cd backend && source .venv/bin/activate && uvicorn app.main:app --reload --port 8000",
      "problemMatcher": []
    },
    {
      "label": "Frontend: run Next.js",
      "type": "shell",
      "command": "cd frontend && npm run dev",
      "problemMatcher": []
    },
    {
      "label": "Backend: tests",
      "type": "shell",
      "command": "cd backend && source .venv/bin/activate && pytest",
      "problemMatcher": []
    }
  ]
}
